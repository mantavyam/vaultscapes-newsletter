# Copy to .env and fill in. `.env` is gitignored — never commit credentials.

# --- Feed repo location (used to build absolute raw URLs in index.json) ---
# The GitHub repo you push this project to (owner/name):
FEED_GITHUB_REPO=<owner>/vaultscapes-news-feed
FEED_GITHUB_BRANCH=main
# Optional explicit override (takes precedence over the two values above):
# FEED_RAW_BASE=https://raw.githubusercontent.com/<owner>/vaultscapes-news-feed/main

# --- Gmail (local runs only; CI reads GitHub Secrets instead) ---
# App password: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
